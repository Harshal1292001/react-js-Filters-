      style={{ height: '46px' }}
    />
  </div>
</div>

// ────────────────────────────────────────────────
// Update filteredQaData memo
const filteredQaData = useMemo(() => {
  let data = qaData;

  // 1. Status filter
  if (selectedMainId) {
    data = data.filter(item => String(item.Main_status) === selectedMainId);
  }

  // 2. Text search
  if (searchTerm.trim()) {
    const term = searchTerm.toLowerCase();
    data = data.filter(item =>
      Object.values(item).some(val => String(val || '').toLowerCase().includes(term))
    );
  }

  // 3. Date range filter – check ANY of the four date fields
  if (fromDate || toDate) {
    const from = fromDate ? new Date(fromDate) : null;
    const to   = toDate   ? new Date(toDate)   : null;

    // Make "to" inclusive (end of day)
    if (to) {
      to.setHours(23, 59, 59, 999);
    }

    data = data.filter(item => {
      const datesToCheck = [
        item.QC_Date,
        item.Approve_Status_Date,
        item.Check_Status_Date,
        item.System_Date,           // ← change name if your field is different (e.g. CreatedAt, EntryDate)
      ];

      // At least one date must be in range
      return datesToCheck.some(dateStr => {
        if (!dateStr) return false;

        // Try parsing – accept different formats your backend might send
        const d = new Date(dateStr);

        if (isNaN(d.getTime())) return false;

        if (from && d < from) return false;
        if (to   && d > to)   return false;

        return true;
      });
    });
  }

  return data;
}, [qaData, selectedMainId, searchTerm, fromDate, toDate]);

// Optional: reset page when important filters change
useEffect(() => {
  setCurrentPage(1);
}, [selectedProject, selectedMainId, fromDate, toDate, searchTerm]);
