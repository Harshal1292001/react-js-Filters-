// Add / update these state declarations
const [fromDate, setFromDate] = useState('');    // yyyy-mm-dd
const [toDate, setToDate] = useState('');

// ────────────────────────────────────────────────
// Inside the filters row (inside .row.g-4)
<div className="row g-4">
  {/* Existing Project select */}
  <div className="col-lg-4 col-md-6">...</div>

  {/* Existing Status select */}
  <div className="col-lg-4 col-md-6">...</div>

  {/* Search – make it smaller to fit dates */}
  <div className="col-lg-4 col-md-6">
    <label className="form-label fw-bold text-gray-800">Search Records</label>
    <input
      type="text"
      className="form-control rounded-pill"
      placeholder="Search by any field..."
      value={searchTerm}
